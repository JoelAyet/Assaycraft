{
  "name": "assaycraft",
  "private": true,
  "homepage": "https://assaycraftlab.com",
  "version": "1.1.0",
  "description": "A local-first electronic lab notebook for the browser. Entries are saved as Markdown files.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "fflate": "^0.8.3",
    "heic-to": "1.6.7",
    "ical.js": "2.2.1",
    "jsqr": "1.4.0",
    "lucide-react": "^1.58.0",
    "markdown-it": "^14.3.3",
    "pdfjs-dist": "^6.4.299",
    "prosemirror-markdown": "^1.13.8",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "utif": "^3.1.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "^1.56.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/utif": "^3.0.6",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.150.0",
    "ws": "8.22.0"
  }
}
